# ==========================================================
#  Eduvia — environment variables (TEMPLATE)
#  1. Copy this file to `.env`   ->   cp .env.example .env
#  2. Fill in real values. NEVER commit or upload `.env`.
#  3. On Vercel: Project -> Settings -> Environment Variables
#
#  NOTE: the current site is fully static and does not read these yet.
#  They are used once you add a backend (Vercel /api functions, Node, etc.).
#  Only variables starting with PUBLIC_ are safe to expose to the browser.
# ==========================================================

# ---------- App ----------
APP_NAME=Eduvia
APP_TAGLINE="The art of learning"
APP_ENV=development                # development | preview | production
APP_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:8000

# ---------- Auth (login / signup) ----------
AUTH_SECRET=                       # long random string: openssl rand -base64 32
SESSION_MAX_AGE_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Database (users, courses, enrolments, progress) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/eduvia

# ---------- Video hosting / storage ----------
PUBLIC_VIDEO_CDN_URL=https://cdn.example.com/eduvia/videos
STORAGE_BUCKET=eduvia-videos
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---------- Email (welcome mail, newsletter, password reset) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Eduvia <hello@eduvia.example>"

# ---------- Payments (optional, paid courses) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PUBLIC_RAZORPAY_KEY_ID=

# ---------- Analytics (optional) ----------
PUBLIC_GA_MEASUREMENT_ID=
